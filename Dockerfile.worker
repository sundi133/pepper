FROM node:20-alpine AS base
WORKDIR /app

RUN apk add --no-cache libc6-compat git unzip

COPY package.json package-lock.json ./
# Runtime deps only. devDependencies (vitest, typescript, eslint,
# tailwindcss, @types/*, etc.) are not needed by the worker — they bloat
# the image and the BuildKit layer cache. tsx and tsconfig-paths now live
# in `dependencies` so they're still installed here.
RUN npm ci --omit=dev

COPY prisma ./prisma
COPY prisma.config.ts ./
RUN npx prisma generate

COPY tsconfig.json ./
COPY src ./src
COPY scripts ./scripts

FROM base AS worker
ENV NODE_ENV=production

RUN apk add --no-cache subversion

# Trivy powers container/serverless image CVE scanning. Without it on PATH the
# container scanner reports zero CVEs, which is indistinguishable from a clean
# image — so it ships in the worker rather than being an operator prerequisite.
# Copied from the official image so the version is pinned and reproducible.
COPY --from=aquasec/trivy:0.72.0 /usr/local/bin/trivy /usr/local/bin/trivy

# Trivy caches its vulnerability database here. For air-gapped installs, mount a
# pre-populated cache at this path and set VULN_DB_MODE=offline so Trivy skips
# the DB update and scans against the bundled database.
ENV TRIVY_CACHE_DIR=/var/cache/trivy
RUN mkdir -p /var/cache/trivy

CMD ["npx", "tsx", "src/worker/index.ts"]
