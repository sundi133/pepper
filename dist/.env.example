# Pepper — configuration. Copy to .env and fill in the REQUIRED section.
# `./setup.sh` does this for you and generates the secrets.

# ═══ REQUIRED ════════════════════════════════════════════════════════════════

# Pepper version to run (image tag from your Pepper contact, e.g. sha-a0c538e).
PEPPER_VERSION="CHANGE_ME_version_tag"

# The URL users open in the browser (must match exactly, incl. https and port).
NEXTAUTH_URL="https://pepper.yourcompany.local"

# Secrets — long random values: `openssl rand -hex 32` (hex only: `/` or `+`
# in POSTGRES_PASSWORD would break the database URL). NEXTAUTH_SECRET
# also encrypts stored tokens: keep it safe and never change it after setup.
NEXTAUTH_SECRET="CHANGE_ME_random_secret"
POSTGRES_PASSWORD="CHANGE_ME_strong_random_password"
MINIO_ROOT_USER="pepper"
MINIO_ROOT_PASSWORD="CHANGE_ME_minio_password"

# First administrator (created on first start).
ADMIN_EMAIL="admin@yourcompany.com"
ADMIN_PASSWORD="CHANGE_ME_admin_password"

# ═══ AI model (can also be changed later in Settings → LLM Config) ═══════════
# Any OpenAI-compatible endpoint works, including a self-hosted gateway, vLLM
# or Azure OpenAI. Examples:
#   OpenRouter:  LLM_PROVIDER=openrouter  LLM_BASE_URL=https://openrouter.ai/api/v1
#   OpenAI:      LLM_PROVIDER=openai      LLM_BASE_URL=https://api.openai.com/v1
#   Anthropic:   LLM_PROVIDER=anthropic   LLM_BASE_URL=https://api.anthropic.com
#   Azure OpenAI: LLM_PROVIDER=azure      LLM_BASE_URL=https://<resource>.openai.azure.com/openai/v1
#   Internal:    LLM_PROVIDER=custom      LLM_BASE_URL=https://llm.yourcompany.local/v1
#   Ollama:      LLM_PROVIDER=ollama      OLLAMA_HOST=http://ollama-host:11434
LLM_PROVIDER="openrouter"
LLM_BASE_URL="https://openrouter.ai/api/v1"
LLM_MODEL="google/gemini-2.5-flash"
LLM_API_KEY=""

# ═══ OPTIONAL ════════════════════════════════════════════════════════════════

# Web port on this host (default 3000) and bind address.
# PEPPER_PORT=3000
# PEPPER_BIND_ADDRESS=0.0.0.0

# Private registry / mirror holding the Pepper images (default: Docker Hub).
# PEPPER_API_IMAGE="registry.yourcompany.local/pepper/pepper-api"
# PEPPER_WORKER_IMAGE="registry.yourcompany.local/pepper/pepper-worker"

# ─── Network ────────────────────────────────────────────────────────────────
# Outbound proxy for the LLM, vulnerability database (OSV) and repo hosts.
# HTTPS_PROXY="http://proxy.yourcompany.local:8080"
# HTTP_PROXY="http://proxy.yourcompany.local:8080"
# NO_PROXY="tfs.yourcompany.local,.yourcompany.local"
# Internal CA: put the PEM in ./certs/ next to docker-compose.yml, then:
# NODE_EXTRA_CA_CERTS="/certs/internal-ca.pem"
# GIT_SSL_CAINFO="/certs/internal-ca.pem"

# ─── Single sign-on ─────────────────────────────────────────────────────────
# Microsoft Entra ID (OpenID Connect). Redirect URI to register:
#   {NEXTAUTH_URL}/api/auth/callback/entra
# ENABLE_ENTRA_SSO="true"
# ENTRA_TENANT_ID=""
# ENTRA_CLIENT_ID=""
# ENTRA_CLIENT_SECRET=""
# ENTRA_ROLE_MAP='{"Pepper.Admin":"ADMIN","Pepper.Security":"SECURITY","Pepper.Developer":"DEVELOPER"}'
# ENTRA_REQUIRE_ROLE="false"
# ENTRA_ROLE_SYNC="raise"          # or "exact"
#
# SAML 2.0 (any IdP). ACS URL: {NEXTAUTH_URL}/api/auth/saml/acs
# ENABLE_SAML_SSO="true"
# SAML_ENTRY_POINT=""
# SAML_IDP_CERT=""
# SAML_ROLE_MAP='{"pepper-admins":"ADMIN","appsec":"SECURITY"}'
# SAML_DEFAULT_ROLE="VIEWER"
#
# Shorter sessions so SSO removals take effect sooner (default 30 days).
# SESSION_MAX_AGE_HOURS=12
# Self-registration at /register (default true). Usually off with SSO.
# ALLOW_PUBLIC_REGISTRATION="false"

# ─── Azure DevOps Server (on-prem) ──────────────────────────────────────────
# 6.0 for Server 2020, 7.0 for Server 2022, 7.1 for Azure DevOps Services.
# AZURE_DEVOPS_API_VERSION="7.0"
# AZURE_DEVOPS_WEBHOOK_SECRET=""   # Basic-auth password on the service hook

# ─── Email (notifications) ──────────────────────────────────────────────────
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="pepper@yourcompany.com"

# ─── Audit log ──────────────────────────────────────────────────────────────
# Default keep forever; admins can set per-organization retention in the UI.
# AUDIT_LOG_RETENTION_DAYS=90

# ─── Scanning ───────────────────────────────────────────────────────────────
# WORKER_CONCURRENCY=2              # scans in parallel per worker
# MAX_LLM_CONCURRENCY=5             # parallel LLM requests
# ENABLE_OPENGREP_SAST="true"       # rule-based SAST (on by default)
# ENABLE_TRIVY_IAC="true"           # rule-based IaC / Kubernetes (on by default)
