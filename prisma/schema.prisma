generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Multi-tenancy ─────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          OrgMember[]
  projects         Project[]
  settings         OrgSettings?
  githubConnection    OrgGithubConnection?
  bitbucketConnection OrgBitbucketConnection?
  azureDevOpsConnection OrgAzureDevOpsConnection?
  gitLabConnection    OrgGitLabConnection?
  apiKeys          ApiKey[]
  securityPolicies SecurityPolicy[]
  suppressionRules SuppressionRule[]
  notifications    Notification[]
  integrations     IntegrationConfig[]
}

/// Org-scoped GitHub OAuth (repository import & private clone). Token stored encrypted.
model OrgGithubConnection {
  id               String    @id @default(cuid())
  organizationId   String    @unique
  githubUserId     String?
  githubLogin      String?
  accessTokenEnc   String    @db.Text
  scope            String?
  tokenExpiresAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Bitbucket Cloud connection: app-password based.
/// Customer creates an app password under their Bitbucket account settings,
/// pastes username + app password into Pepper. We store the app password
/// encrypted using the same scheme as GitHub tokens.
model OrgBitbucketConnection {
  id              String   @id @default(cuid())
  organizationId  String   @unique
  workspace       String?
  username        String
  appPasswordEnc  String   @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Azure DevOps Services connection: Personal Access Token (PAT) based.
/// PATs in Azure DevOps are scoped to a single ADO organization (the
/// `dev.azure.com/<org>` segment), so we store the org name alongside the
/// encrypted token. The PAT is sent as `Authorization: Basic <base64(':' + PAT)>`
/// against the ADO REST API.
model OrgAzureDevOpsConnection {
  id                  String   @id @default(cuid())
  organizationId      String   @unique
  azureOrganization   String
  azureUser           String?
  patEnc              String   @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// GitLab connection: Personal Access Token (PAT) scoped to api + read_user.
/// Supports both gitlab.com and self-hosted instances.
model OrgGitLabConnection {
  id              String   @id @default(cuid())
  organizationId  String   @unique
  hostUrl         String   @default("https://gitlab.com")
  gitlabUserId    Int?
  gitlabUsername  String?
  accessTokenEnc  String   @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OrgMember {
  id             String   @id @default(cuid())
  role           Role     @default(DEVELOPER)
  userId         String
  organizationId String
  createdAt      DateTime @default(now())

  // Notification preferences
  emailOnScanComplete Boolean @default(true)
  emailOnGateFail     Boolean @default(true)
  emailOnCritical     Boolean @default(true)

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
}

enum Role {
  ADMIN
  SECURITY
  DEVELOPER
  VIEWER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  memberships OrgMember[]
  notifications Notification[]
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core domain ───────────────────────────────────────────────────

model Project {
  id             String   @id @default(cuid())
  name           String
  description    String?
  repoUrl        String?
  defaultBranch  String   @default("main")
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// Set when imported via GitHub OAuth (unique per org).
  githubRepoId       Int?
  githubOwner        String?
  githubRepoName     String?
  primaryLanguage    String?
  connectedViaGithub Boolean @default(false)

  /// Set when imported via Bitbucket Cloud (unique per org).
  bitbucketWorkspace    String?
  bitbucketRepoSlug     String?
  bitbucketRepoUuid     String?
  connectedViaBitbucket Boolean @default(false)

  /// Set when imported via Azure DevOps Services (unique per org).
  azureOrganization   String?
  azureProjectName    String?
  azureRepoId         String?
  azureRepoName       String?
  connectedViaAzure   Boolean @default(false)

  /// Set when a GitLab MR webhook triggers a scan. Used to post MR notes.
  gitlabProjectId     Int?
  gitlabNamespace     String?    // e.g. "myorg/myrepo"


  organization Organization @relation(fields: [organizationId], references: [id])
  scans        Scan[]
  buildGate    BuildGate?
  schedule     ScanSchedule?

  @@unique([organizationId, githubRepoId])
  @@unique([organizationId, bitbucketRepoUuid])
  @@unique([organizationId, azureRepoId])
}

model Scan {
  id         String     @id @default(cuid())
  status     ScanStatus @default(QUEUED)
  scanType   ScanType   @default(FULL)
  branch     String?
  commitSha  String?
  prNumber   Int?
  baseSha    String?
  sourceType SourceType @default(UPLOAD)
  sourceRef  String?
  projectId  String     @unique
  triggeredBy String?
  jobId      String?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  criticalCount Int @default(0)
  highCount     Int @default(0)
  mediumCount   Int @default(0)
  lowCount      Int @default(0)
  infoCount     Int @default(0)

  filesScanned      Int @default(0)
  depsScanned       Int @default(0)
  autoResolvedCount Int @default(0)
  newFindingCount   Int @default(0)

  scannerProgress Json?

  gateResult GateResult @default(PENDING)
  errorMessage String?

  project   Project        @relation(fields: [projectId], references: [id])
  findings  Finding[]
  artifacts ScanArtifact[]
  notifications Notification[]
}

model Notification {
  id               String   @id @default(cuid())
  userId           String
  organizationId String
  type             String   @default("SCAN_QUEUED")
  title            String
  body             String?  @db.Text
  read             Boolean  @default(false)
  scanId           String?
  createdAt        DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scan         Scan?        @relation(fields: [scanId], references: [id], onDelete: SetNull)

  @@index([userId, read, createdAt])
  @@index([organizationId])
}

enum ScanStatus {
  QUEUED
  RUNNING
  PAUSED
  STOPPED
  COMPLETED
  FAILED
  CANCELLED
}

enum ScanType {
  FULL
  INCREMENTAL
  SAST_ONLY
  SCA_ONLY
  SECRETS_ONLY
  IAC_ONLY
  ZERO_DAY_ONLY
  CONTAINER_ONLY
  K8S_ONLY
}

enum SourceType {
  UPLOAD
  GIT_CLONE
  SVN_CHECKOUT
  WEBHOOK
  CONTAINER_IMAGE
  PRECOMMIT
}

enum GateResult {
  PENDING
  PASSED
  FAILED
}

model Finding {
  id              String        @id @default(cuid())
  scanId          String
  scanner         Scanner
  severity        Severity
  title           String
  description     String        @db.Text
  filePath        String?
  startLine       Int?
  endLine         Int?
  snippet         String?       @db.Text
  ruleId          String?
  cweId           String?
  cveId           String?
  confidence      Float?
  metadata        Json?
  masked          Boolean       @default(false)
  riskScore       Int?          // 1–100 composite risk score (severity × scanner × confidence × file-path)
  isNew           Boolean?      // null = no previous scan; true = new; false = persisting
  status          FindingStatus @default(OPEN)
  statusNote      String?
  statusUpdatedBy String?
  statusUpdatedAt DateTime?
  createdAt       DateTime      @default(now())

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId, severity])
  @@index([scanId, scanner])
  @@index([scanId, filePath])
  @@index([scanId, status])
  @@index([scanId, isNew])
}

enum FindingStatus {
  OPEN
  IN_PROGRESS
  FALSE_POSITIVE
  ACCEPTED_RISK
  RESOLVED
}

enum Scanner {
  SAST_PATTERN
  SAST_LLM
  SCA
  SECRETS_PATTERN
  SECRETS_LLM
  IAC
  MALICIOUS_PKG
  ZERO_DAY
  CONTAINER
  K8S
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

model ScanArtifact {
  id        String       @id @default(cuid())
  scanId    String
  type      ArtifactType
  objectKey String
  size      Int?
  createdAt DateTime     @default(now())

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, type])
}

enum ArtifactType {
  SARIF
  SBOM_CYCLONEDX
  SBOM_SPDX
  SCAN_LOG
  CONTAINER_REPORT
  SIGNATURE
  /// OpenVEX 0.2.0 — exploitability statements accompanying the SBOM.
  VEX_OPENVEX
  /// CycloneDX 1.5 VEX — same statements for CycloneDX-native consumers.
  VEX_CYCLONEDX
}

model BuildGate {
  id          String  @id @default(cuid())
  projectId   String  @unique
  maxCritical Int     @default(0)
  maxHigh     Int     @default(5)
  maxMedium   Int     @default(20)
  maxLow      Int     @default(-1) // -1 = unlimited
  failOnNew   Boolean @default(true)

  project Project @relation(fields: [projectId], references: [id])
}

model ScanSchedule {
  id        String       @id @default(cuid())
  projectId String       @unique
  enabled   Boolean      @default(true)
  frequency ScheduleFreq
  cronExpr  String?
  scanType  ScanType     @default(FULL)
  branch    String?
  lastRunAt DateTime?
  nextRunAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

enum ScheduleFreq {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM
}

model OrgSettings {
  id               String  @id @default(cuid())
  organizationId   String  @unique
  llmProvider      String  @default("openai")
  llmBaseUrl       String  @default("https://api.openai.com/v1")
  llmModel         String  @default("gpt-4o-mini")
  llmApiKey        String? @db.Text
  enableLlmSast    Boolean @default(true)
  enableLlmSecrets Boolean @default(true)
  /** Fine-grained or classic PAT: contents + pull requests (repo scope for classic). Used only to open fix PRs. */
  githubPrToken    String? @db.Text
  osvApiUrl        String  @default("https://api.osv.dev")
  vulnDbMode       String  @default("online")

  // SMTP Email Configuration
  smtpHost        String?
  smtpPort        Int?     @default(587)
  smtpUser        String?
  smtpPassword    String?  @db.Text
  smtpFromAddress String?  @default("noreply@pepper-sast.local")
  smtpUseTls      Boolean  @default(true)

  // Code signing (cosign keyless or key-based)
  codeSigningEnabled Boolean @default(false)
  codeSigningMode    String  @default("keyless") // "keyless" | "key"
  codeSigningKeyEnc  String? @db.Text
  codeSigningIdentity String?

  // Container registry authentication (encrypted)
  containerRegistryType        String?          // "dockerhub" | "ecr" | "gcr" | "ghcr" | "custom"
  containerRegistryUsernameEnc String? @db.Text
  containerRegistryPasswordEnc String? @db.Text
  containerRegistryRegion      String?          // AWS region for ECR (e.g., "us-east-1")

  // Inbound VCS webhook secrets (encrypted); configure in Settings → Integrations
  githubWebhookSecretEnc     String? @db.Text
  gitlabWebhookSecretEnc     String? @db.Text
  bitbucketWebhookSecretEnc  String? @db.Text
  azureDevOpsWebhookSecretEnc String? @db.Text

  organization Organization @relation(fields: [organizationId], references: [id])
}

model SecurityPolicy {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  description    String?         @db.Text
  rule           String          @db.Text   // Natural language rule the LLM should enforce
  severity       Severity        @default(HIGH)
  enabled        Boolean         @default(true)
  category       String?                    // e.g. "Data Privacy", "Compliance", "Internal Standard"
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, enabled])
}

/// Per-org suppression rules — auto-generated when users mark findings as FP.
/// During scans, new findings are checked against active rules and pre-suppressed.
model SuppressionRule {
  id              String    @id @default(cuid())
  organizationId  String
  projectId       String?                  // null = org-wide, set = project-specific
  ruleId          String?                  // scanner rule ID to match
  cweId           String?                  // CWE ID to match
  scanner         String?                  // scanner type to match (e.g. "SAST_PATTERN")
  filePathPattern String?                  // glob or substring match against finding filePath
  titlePattern    String?                  // substring match against finding title
  snippetHash     String?                  // SHA-256 of normalized snippet for exact code match
  reason          String    @db.Text       // why this was suppressed
  source          String    @default("user") // "user" | "auto" | "bulk"
  sourceFindingId String?                  // the finding that triggered this rule
  enabled         Boolean   @default(true)
  expiresAt       DateTime?                // optional TTL
  createdAt       DateTime  @default(now())
  createdBy       String?                  // userId

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, enabled])
  @@index([organizationId, ruleId])
  @@index([organizationId, cweId])
}

model ApiKey {
  id             String    @id @default(cuid())
  name           String
  keyHash        String    @unique
  prefix         String
  organizationId String
  createdBy      String
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
}

/// Outbound integrations: Jira, Slack, SIEM (HTTPS/syslog).
model IntegrationConfig {
  id             String          @id @default(cuid())
  organizationId String
  kind           IntegrationKind
  name           String
  enabled        Boolean         @default(true)
  /// Encrypted JSON config (webhook URLs, API tokens, target hosts, etc.)
  configEnc      String          @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind])
}

enum IntegrationKind {
  JIRA
  SLACK
  SIEM
  CODE_SIGNING
  WEBHOOK
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String
  resource       String
  resourceId     String?
  details        Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([action])
}
