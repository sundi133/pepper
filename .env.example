# Database
DATABASE_URL="postgresql://pepper:pepper_dev@localhost:5432/pepper"

# Redis
REDIS_URL="redis://localhost:6379"

# MinIO / S3
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_USE_SSL="false"
MINIO_BUCKET="pepper-artifacts"

# NextAuth
NEXTAUTH_SECRET="change-me-to-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Public self-registration at /register (creates a new org + admin user). Set false to disable.
ALLOW_PUBLIC_REGISTRATION="true"

# Optional: hCaptcha on login & registration (bot / brute-force protection).
# Set BOTH to enable; leave unset to disable. Get keys at https://dashboard.hcaptcha.com/
# The site key is read on the server at runtime (no rebuild needed).
# NEXT_PUBLIC_HCAPTCHA_SITE_KEY also works if you prefer build-time inlining.
# HCAPTCHA_SITE_KEY=""      # public site key (rendered in the browser widget)
# HCAPTCHA_SECRET_KEY=""    # server secret (verification only — keep private)

# Optional: public URL shown as "Source" / "View project source" on the login page
# NEXT_PUBLIC_SOURCE_CODE_URL="https://github.com/your-org/pepper"

# ─── SAML SSO (optional, single org-wide IdP — on-prem) ──────────────────────
# Enterprise single sign-on against one SAML 2.0 IdP (Okta, Entra/Azure AD,
# OneLogin, Ping, …). Off by default; email/password and GitHub login are
# unchanged when off. The SP endpoints are:
#   Login (SP-initiated):  {NEXTAUTH_URL}/api/auth/saml/login
#   ACS (Reply URL):       {NEXTAUTH_URL}/api/auth/saml/acs
#   SP metadata / EntityID:{NEXTAUTH_URL}/api/auth/saml/metadata
# Configure your IdP with the ACS URL above and release an email claim (and,
# for role mapping, a groups claim). Requires the assertion to be signed.
# ENABLE_SAML_SSO="true"
# SAML_ENTRY_POINT="https://your-idp.example/app/xxxx/sso/saml"   # IdP SSO URL
# SAML_IDP_CERT="MIID...base64 PEM body..."   # IdP signing cert; comma-separate to rotate
# SAML_ISSUER=""                              # SP entity id; defaults to the metadata URL
# SAML_WANT_ASSERTIONS_SIGNED="true"          # require a signed <Assertion> (default). Set
#                                             # "false" if the IdP signs only the <Response>.
# Attribute names (leave blank to use common IdP defaults / nameID):
# SAML_EMAIL_ATTR=""                          # e.g. email / mail / emailaddress claim
# SAML_NAME_ATTR=""                           # e.g. displayName
# SAML_GROUP_ATTR="groups"                    # attribute carrying group memberships
# Role mapping (IdP groups are authoritative; highest-privilege match wins):
# SAML_ROLE_MAP='{"pepper-admins":"ADMIN","appsec":"SECURITY","engineers":"DEVELOPER"}'
# SAML_DEFAULT_ROLE="VIEWER"                  # role when no group matches
# SAML_DEFAULT_ORG_SLUG=""                    # org to provision users into; blank = oldest org

# Optional: GitHub OAuth (NextAuth login and/or repository connection)
# GITHUB_ID=""
# GITHUB_SECRET=""
# Dedicated OAuth app for "Connect GitHub Repository" (falls back to GITHUB_ID / GITHUB_SECRET)
# Register callback: {NEXTAUTH_URL}/api/integrations/github/callback
# GITHUB_OAUTH_CLIENT_ID=""
# GITHUB_OAUTH_CLIENT_SECRET=""
# Optional: separate key for encrypting stored tokens (defaults to NEXTAUTH_SECRET)
# TOKEN_ENCRYPTION_KEY=""
# Optional fallback if not set in Settings → Integrations → Webhook secrets:
# GITHUB_WEBHOOK_SECRET=""
# After push/merge to default branch, GitHub/Bitbucket/Azure webhooks queue SAST_ONLY (or FULL):
# GITHUB_WEBHOOK_MAIN_SCAN_TYPE="SAST_ONLY"

# Optional: Bitbucket Cloud webhook signing secret. When set, Pepper verifies
# the X-Hub-Signature header on /api/webhooks/bitbucket. The per-org
# Bitbucket app password is configured via the Integrations UI
# (POST /api/integrations/bitbucket/connect) — no env var needed for that.
# BITBUCKET_WEBHOOK_SECRET=""  # optional; prefer UI Webhook secrets

# Optional: Azure DevOps Services webhook shared secret. ADO service hooks
# don't support HMAC signing, so configure the webhook with Basic auth and
# put this value in the password field — Pepper verifies it on every
# request to /api/webhooks/azure-devops. The per-org ADO PAT is configured
# via the Integrations UI (POST /api/integrations/azure-devops/connect).
# AZURE_DEVOPS_WEBHOOK_SECRET=""  # optional; prefer UI Webhook secrets

# Optional: Azure DevOps REST API version. Default 7.1 suits Azure DevOps
# Services (cloud) and recent Azure DevOps Server. Older on-prem Server releases
# may need an earlier version (e.g. 6.0 for Server 2020, 5.0 for 2019). The
# on-prem Server base URL itself is configured per-org in the Integrations UI.
# AZURE_DEVOPS_API_VERSION="7.1"

# Open fix PR uses the GitHub OAuth token from Repositories (no PAT required).
# Legacy optional PAT (not used if OAuth is connected):
# GITHUB_PR_TOKEN=""
# GITHUB_TOKEN=""

# Optional: GitLab OAuth
# GITLAB_ID=""
# GITLAB_SECRET=""
# GITLAB_URL="https://gitlab.com"

# OpenRouter (alternative to Ollama — access 100+ cloud models)
# Get your key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=""
# OPENROUTER_MODEL="google/gemini-2.5-flash"

# DAST / Dapper orchestration
# Local Pepper scans can bootstrap a sibling ../dapper checkout automatically.
# Override the workspace root if you want Pepper to use a specific Dapper repo.
# DAPPER_WORKSPACE_DIR=""
# DAPPER_REPO_URL="https://github.com/sundi133/dapper.git"
# DAPPER_CONFIG_PATH=""
# DAPPER_EXPORT_MODEL="claude-opus-5"
# DAPPER_EXPORT_MAX_TURNS="100"
# DAPPER_ROUTER="false"
# DAPPER_PIPELINE_TESTING="false"

# Worker
WORKER_CONCURRENCY="2"
MAX_LLM_CONCURRENCY="5"

# LLM SAST Context Configuration
# Chunk tokens = how much code is sent per LLM request (estimated tokens)
# Response tokens = max tokens the LLM can generate in its response
# Overlap tokens = context overlap between consecutive chunks
# LLM_CHUNK_TOKENS="3000"              # API models (OpenAI, etc.)
# LLM_CHUNK_OVERLAP_TOKENS="200"
# LLM_MAX_RESPONSE_TOKENS="4096"
# OLLAMA_CHUNK_TOKENS="1200"           # Local Ollama models
# OLLAMA_CHUNK_OVERLAP_TOKENS="100"
# OLLAMA_MAX_RESPONSE_TOKENS="2048"
# LLM_MIN_CONFIDENCE="0.7"            # Drop findings below this confidence

# Email Notifications (optional — SMTP)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="noreply@pepper-sast.local"
# SMTP_TLS="true"
# Team invites for brand-new users include the initial password in email when
# SMTP is enabled—use a test sink (Mailpit) or trusted mail; not for public SMTP.

# Default Admin (used by seed script)
ADMIN_EMAIL="admin@pepper.local"
ADMIN_PASSWORD="pepper-admin-changeme"

# ─── Exploit validation (optional, default off) ──────────────────────────
# Adversarial second pass that red-teams AI findings (SAST_LLM + ZERO_DAY) to
# confirm real exploitability, drop clear false positives, and attach a concrete
# attack path. Runs after scanning, before the build gate. Requires LLM SAST to
# be configured. Only ever suppresses findings the model is confident are not
# exploitable; a model error leaves findings untouched.
# ENABLE_EXPLOIT_VALIDATION="true"
# EXPLOIT_VALIDATION_MIN_SEVERITY="HIGH"   # validate findings at/above this severity
# EXPLOIT_VALIDATION_BATCH="10"            # findings per LLM request
# EXPLOIT_VALIDATION_CONTEXT_LINES="40"    # code lines of context around each finding
# EXPLOIT_VALIDATION_DROP_CONFIDENCE="0.8" # min model confidence to drop a finding

# ─── Web research (optional) ─────────────────────────────────────────────
# Corroborates suspected malicious packages against public reports.
# Leave unset to disable; required for ENABLE_WEB_RESEARCH to have any effect.
TAVILY_API_KEY=
ENABLE_WEB_RESEARCH=true
WEB_RESEARCH_MAX_PER_SCAN=10
